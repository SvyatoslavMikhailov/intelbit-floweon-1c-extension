#Область ПрограммныйИнтерфейс

// СформироватьУспешныйОтвет — формирует JSON-ответ HTTPСервиса (200 OK).
//
// Параметры:
//   Данные — Произвольный — данные ответа (Структура, Массив, Соответствие)
//
// Возвращаемое значение:
//   HTTPСервисОтвет
Функция СформироватьУспешныйОтвет(Данные) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки["Content-Type"] = "application/json; charset=utf-8";

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);

	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8");
	Возврат Ответ;
КонецФункции

// СформироватьОшибку — формирует JSON-ошибку по RFC 7807 Problem Details.
//
// Параметры:
//   КодHTTP    — Число   — HTTP-код ответа (400, 404, 500 и т.д.)
//   КодОшибки  — Строка  — машиночитаемый код (ERR_VALIDATION, ERR_NOT_FOUND и т.д.)
//   Сообщение  — Строка  — человекочитаемое описание ошибки
//
// Возвращаемое значение:
//   HTTPСервисОтвет
Функция СформироватьОшибку(КодHTTP, КодОшибки, Сообщение) Экспорт
	Ответ = Новый HTTPСервисОтвет(КодHTTP);
	Ответ.Заголовки["Content-Type"] = "application/problem+json; charset=utf-8";

	Тело = Новый Структура("type,title,status,detail",
		"about:blank", КодОшибки, КодHTTP, Сообщение);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Тело);

	Ответ.УстановитьТелоИзСтроки(Запись.Закрыть(), "UTF-8");
	Возврат Ответ;
КонецФункции

// ПрочитатьТелоJSON — десериализует тело запроса из JSON.
//
// Параметры:
//   Запрос — HTTPСервисЗапрос
//
// Возвращаемое значение:
//   Структура, Соответствие или Неопределено при ошибке парсинга
Функция ПрочитатьТелоJSON(Запрос) Экспорт
	ТелоСтрока = Запрос.ПолучитьТелоКакСтроку("UTF-8");

	Если ПустаяСтрока(ТелоСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТелоСтрока);
		Возврат ПрочитатьJSON(Чтение);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// ПолучитьПараметрыURL — разбирает строку запроса (query string) из URL.
//
// Параметры:
//   Запрос — HTTPСервисЗапрос
//
// Возвращаемое значение:
//   Соответствие — ключ/значение параметров (без URL-декодирования)
Функция ПолучитьПараметрыURL(Запрос) Экспорт
	Результат = Новый Соответствие;
	АдресURL   = Запрос.АдресURL;
	Позиция    = Найти(АдресURL, "?");

	Если Позиция = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	СтрокаПараметров = Сред(АдресURL, Позиция + 1);

	Для Каждого Пара Из СтрРазделить(СтрокаПараметров, "&", Ложь) Цикл
		ПозРавно = Найти(Пара, "=");
		Если ПозРавно > 0 Тогда
			Ключ   = Лев(Пара, ПозРавно - 1);
			Знач   = Сред(Пара, ПозРавно + 1);
			Результат[Ключ] = Знач;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Логировать — записывает событие в журнал регистрации.
//
// Параметры:
//   Уровень   — Строка — Информация | Предупреждение | Ошибка
//   Сообщение — Строка — текст записи
Процедура Логировать(Уровень, Сообщение) Экспорт
	СоответствиеУровней = Новый Соответствие;
	СоответствиеУровней["Информация"]     = УровеньЖурналаРегистрации.Информация;
	СоответствиеУровней["Предупреждение"] = УровеньЖурналаРегистрации.Предупреждение;
	СоответствиеУровней["Ошибка"]         = УровеньЖурналаРегистрации.Ошибка;

	УровеньЖурн = СоответствиеУровней[Уровень];
	Если УровеньЖурн = Неопределено Тогда
		УровеньЖурн = УровеньЖурналаРегистрации.Информация;
	КонецЕсли;

	ЗаписьЖурналаРегистрации("ИнтелбитРека", УровеньЖурн, , , Сообщение);
КонецПроцедуры

#КонецОбласти
