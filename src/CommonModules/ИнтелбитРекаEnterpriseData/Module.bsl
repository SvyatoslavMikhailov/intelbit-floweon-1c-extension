#Область ПрограммныйИнтерфейс

// ОтправитьСообщение — формирует и отправляет XML-сообщение EnterpriseData 1.5.
//
// Параметры:
//   Сущности   — Массив — массив структур с полями сущностей
//   ПланОбмена — Строка — имя плана обмена (не используется, зарезервировано)
//   УзелОбмена — Строка — имя узла назначения (не используется, зарезервировано)
//
// Возвращаемое значение:
//   Строка — MessageId отправленного сообщения (UUID)
Функция ОтправитьСообщение(Сущности, ПланОбмена = "", УзелОбмена = "") Экспорт
	АдресРеки = Константы.ИнтелбитРекаURL.Получить();
	Если ПустаяСтрока(АдресРеки) Тогда
		ВызватьИсключение "Константа ИнтелбитРекаURL не задана";
	КонецЕсли;

	MessageId = Строка(Новый УникальныйИдентификатор);
	XMLСообщения = СформироватьXMLСообщение(MessageId, Сущности);

	ПаршHTTP = ИнтелбитРекаВебхуки.РазобратьURL(АдресРеки + "/api/ed/send");

	Соединение = Новый HTTPСоединение(
		ПаршHTTP.Хост,
		ПаршHTTP.Порт,
		,
		,
		,
		60,
		?(ПаршHTTP.HTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено)
	);

	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса["Content-Type"] = "application/xml; charset=utf-8";
	ЗаголовкиЗапроса["X-Message-Id"] = MessageId;

	ЗапросHTTP = Новый HTTPЗапрос(ПаршHTTP.Путь, ЗаголовкиЗапроса);
	ЗапросHTTP.УстановитьТелоИзСтроки(XMLСообщения, "UTF-8");

	ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);
	Если ОтветHTTP.КодСостояния >= 400 Тогда
		ВызватьИсключение "EnterpriseData send error " + ОтветHTTP.КодСостояния
			+ ": " + ОтветHTTP.ПолучитьТелоКакСтроку();
	КонецЕсли;

	ИнтелбитРекаОбщие.Логировать("Информация",
		"EnterpriseData сообщение отправлено: " + MessageId
			+ " (" + Сущности.Количество() + " сущностей)");

	Возврат MessageId;
КонецФункции

// ПолучитьСообщения — получает входящие сообщения EnterpriseData из очереди Реки.
//
// Параметры:
//   ПланОбмена — Строка — не используется, зарезервировано
//   УзелОбмена — Строка — не используется, зарезервировано
//
// Возвращаемое значение:
//   Массив — массив Структур с полями: MessageId (Строка), Сущности (Массив)
Функция ПолучитьСообщения(ПланОбмена = "", УзелОбмена = "") Экспорт
	АдресРеки = Константы.ИнтелбитРекаURL.Получить();
	Если ПустаяСтрока(АдресРеки) Тогда
		ВызватьИсключение "Константа ИнтелбитРекаURL не задана";
	КонецЕсли;

	ПаршHTTP = ИнтелбитРекаВебхуки.РазобратьURL(АдресРеки + "/api/ed/receive");

	Соединение = Новый HTTPСоединение(
		ПаршHTTP.Хост,
		ПаршHTTP.Порт,
		,
		,
		,
		60,
		?(ПаршHTTP.HTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено)
	);

	ЗаголовкиЗапроса = Новый Соответствие;
	ЗаголовкиЗапроса["Accept"]       = "application/xml";
	ЗаголовкиЗапроса["X-Client-Id"]  = Константы.ИнтелбитРекаКлиентID.Получить();

	ЗапросHTTP = Новый HTTPЗапрос(ПаршHTTP.Путь, ЗаголовкиЗапроса);
	ОтветHTTP  = Соединение.Получить(ЗапросHTTP);

	Если ОтветHTTP.КодСостояния = 204 Тогда
		Возврат Новый Массив;
	КонецЕсли;

	Если ОтветHTTP.КодСостояния >= 400 Тогда
		ВызватьИсключение "EnterpriseData receive error " + ОтветHTTP.КодСостояния;
	КонецЕсли;

	Возврат РазобратьXMLОтвет(ОтветHTTP.ПолучитьТелоКакСтроку("UTF-8"));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// СформироватьXMLСообщение — строит XML EnterpriseData 1.5 из массива сущностей.
Функция СформироватьXMLСообщения(MessageId, Сущности)
	НС = "urn:1C.ru:EnterpriseData:1.5";

	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку("UTF-8");
	ЗаписьXML.ЗаписатьОбъявлениеXML();

	ЗаписьXML.ЗаписатьНачалоЭлемента("Message");
	ЗаписьXML.ЗаписатьАтрибут("xmlns",     НС);
	ЗаписьXML.ЗаписатьАтрибут("MessageId", MessageId);

	Для Каждого Сущность Из Сущности Цикл
		ТипСущности = Сущность["__type__"];
		Если ПустаяСтрока(ТипСущности) Тогда
			Продолжить;
		КонецЕсли;

		ЗаписьXML.ЗаписатьНачалоЭлемента(ТипСущности);
		Для Каждого КЗ Из Сущность Цикл
			Если КЗ.Ключ = "__type__" Тогда
				Продолжить;
			КонецЕсли;
			ЗаписьXML.ЗаписатьНачалоЭлемента(КЗ.Ключ);
			ЗаписьXML.ЗаписатьТекст(Строка(КЗ.Значение));
			ЗаписьXML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		ЗаписьXML.ЗаписатьКонецЭлемента();
	КонецЦикла;

	ЗаписьXML.ЗаписатьКонецЭлемента(); // Message
	Возврат ЗаписьXML.Закрыть();
КонецФункции

// РазобратьXMLОтвет — парсит XML EnterpriseData 1.5 в массив структур.
Функция РазобратьXMLОтвет(XMLСтрока)
	Результат = Новый Массив;

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(XMLСтрока);

	MessageId  = "";
	ТекСущность = Неопределено;
	ТекПоле     = "";

	Пока ЧтениеXML.Прочитать() Цикл
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ЛокИмя = ЧтениеXML.ЛокальноеИмя;
			Если ЛокИмя = "Message" Тогда
				MessageId = ЧтениеXML.ЗначениеАтрибута("MessageId");
			ИначеЕсли ТекСущность = Неопределено И ЛокИмя <> "Message" Тогда
				ТекСущность = Новый Структура("__type__", ЛокИмя);
			ИначеЕсли ТекСущность <> Неопределено Тогда
				ТекПоле = ЛокИмя;
			КонецЕсли;

		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			Если ТекСущность <> Неопределено И НЕ ПустаяСтрока(ТекПоле) Тогда
				ТекСущность.Вставить(ТекПоле, ЧтениеXML.Значение);
			КонецЕсли;

		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ЛокИмя = ЧтениеXML.ЛокальноеИмя;
			Если ЛокИмя = "Message" Тогда
				Прервать;
			ИначеЕсли ТекСущность <> Неопределено И ЛокИмя = ТекСущность["__type__"] Тогда
				Результат.Добавить(Новый Структура("MessageId,Сущность", MessageId, ТекСущность));
				ТекСущность = Неопределено;
				ТекПоле     = "";
			Иначе
				ТекПоле = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	ЧтениеXML.Закрыть();
	Возврат Результат;
КонецФункции

#КонецОбласти
