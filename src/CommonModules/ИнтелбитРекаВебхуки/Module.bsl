// ИнтелбитРекаВебхуки — публикация webhook-событий на Python-сторону Реки.
// Формат подписи: X-Signature: t=<unix>,v1=<HMAC-SHA256>.
// Совместим с OneCWebhookReceiver в intelbit-river-connector-onec.
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

#Область ПрограммныйИнтерфейс

// ОпубликоватьСобытие — ставит webhook-событие в очередь (регистр сведений).
//
// Параметры:
//   ТипСобытия — Строка — одно из: catalog.updated, stock.updated,
//                         price.updated, order.status.changed
//   Данные     — Структура — тело события
Процедура ОпубликоватьСобытие(ТипСобытия, Данные) Экспорт
	ИДСобытия = Строка(Новый УникальныйИдентификатор);

	// Дата(1970,1,1,3,0,0) = unix epoch в UTC+3
	НачалоEpoch = Дата(1970, 1, 1, 3, 0, 0);
	UnixМетка   = Цел(ТекущаяДата() - НачалоEpoch);

	СобытиеМет = Новый Структура("event_type,event_id,occurred_at,data",
		ТипСобытия,
		ИДСобытия,
		Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z",
		Данные
	);

	ЗаписьТела = Новый ЗаписьJSON;
	ЗаписьТела.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьТела, СобытиеМет);
	ТелоJSON = ЗаписьТела.Закрыть();

	НЗ = РегистрыСведений.ИнтелбитРекаОчередьВебхуков.СоздатьМенеджерЗаписи();
	НЗ.EventID    = ИДСобытия;
	НЗ.EventType  = ТипСобытия;
	НЗ.Payload    = ТелоJSON;
	НЗ.OccurredAt = ТекущаяДата();
	НЗ.Attempts   = 0;
	НЗ.LastError  = "";
	НЗ.Записать();
КонецПроцедуры

// ОтправитьПакетСобытий — отправляет накопленные события из очереди на Реку.
// Вызывается регламентным заданием ИнтелбитРекаОтправкаВебхуков (каждые 60 сек).
// События с Attempts >= 5 остаются в регистре как DLQ.
//
// Параметры:
//   МаксимальноСобытий — Число — максимальное число событий за один вызов (по умолчанию 50)
Процедура ОтправитьПакетСобытий(МаксимальноСобытий = 50) Экспорт
	АдресРеки = Константы.ИнтелбитРекаURL.Получить();
	Секрет    = Константы.ИнтелбитРекаСекретWebhook.Получить();

	Если ПустаяСтрока(АдресРеки) Тогда
		ИнтелбитРекаОбщие.Логировать("Предупреждение",
			"Константа ИнтелбитРекаURL не задана — отправка вебхуков пропущена");
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ &Лимит
		|	РегОч.EventID   КАК EventID,
		|	РегОч.EventType КАК EventType,
		|	РегОч.Payload   КАК Payload,
		|	РегОч.Attempts  КАК Attempts
		|ИЗ
		|	РегистрСведений.ИнтелбитРекаОчередьВебхуков КАК РегОч
		|ГДЕ
		|	РегОч.Attempts < 5
		|УПОРЯДОЧИТЬ ПО
		|	РегОч.OccurredAt";
	Запрос.УстановитьПараметр("Лимит", МаксимальноСобытий);

	РезЗапроса = Запрос.Выполнить();
	Выборка    = РезЗапроса.Выбрать();

	ПаршHTTP = РазобратьURL(АдресРеки + "/webhooks/onec");

	Пока Выборка.Следующий() Цикл
		ИДСобытия = Выборка.EventID;
		ТелоJSON  = Выборка.Payload;
		КолПоп    = Выборка.Attempts;

		Попытка
			// Дата(1970,1,1,3,0,0) = unix epoch UTC+3
			НачалоEpoch = Дата(1970, 1, 1, 3, 0, 0);
			UnixМетка   = Цел(ТекущаяДата() - НачалоEpoch);
			Подпись     = СформироватьПодпись(ТелоJSON, Секрет, UnixМетка);

			Соединение = Новый HTTPСоединение(
				ПаршHTTP.Хост,
				ПаршHTTP.Порт,
				,
				,
				,
				30,
				?(ПаршHTTP.HTTPS, Новый ЗащищенноеСоединениеOpenSSL(), Неопределено)
			);

			ЗаголовкиЗапроса = Новый Соответствие;
			ЗаголовкиЗапроса["Content-Type"]  = "application/json; charset=utf-8";
			ЗаголовкиЗапроса["X-Signature"]   = Подпись;
			ЗаголовкиЗапроса["X-Event-Type"]  = Выборка.EventType;

			ЗапросHTTP = Новый HTTPЗапрос(ПаршHTTP.Путь, ЗаголовкиЗапроса);
			ЗапросHTTP.УстановитьТелоИзСтроки(ТелоJSON, "UTF-8");

			ОтветHTTP = Соединение.ОтправитьДляОбработки(ЗапросHTTP);

			Если ОтветHTTP.КодСостояния < 500 Тогда
				// Успех (2xx, 4xx — не повторяем) → удаляем из очереди
				НЗ = РегистрыСведений.ИнтелбитРекаОчередьВебхуков.СоздатьМенеджерЗаписи();
				НЗ.EventID = ИДСобытия;
				НЗ.Удалить();
			Иначе
				// 5xx → повторная попытка
				ВызватьИсключение "Сервер вернул " + ОтветHTTP.КодСостояния;
			КонецЕсли;

		Исключение
			ТекстОшибки = ОписаниеОшибки();
			ИнтелбитРекаОбщие.Логировать("Предупреждение",
				"Вебхук не отправлен [" + ИДСобытия + "]: " + ТекстОшибки);
			НЗ = РегистрыСведений.ИнтелбитРекаОчередьВебхуков.СоздатьМенеджерЗаписи();
			НЗ.EventID   = ИДСобытия;
			НЗ.Attempts  = КолПоп + 1;
			НЗ.LastError = Лев(ТекстОшибки, 500);
			НЗ.Записать();
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// СформироватьПодпись — HMAC-SHA256 по схеме t=<unix>,v1=<hex>.
//
// Параметры:
//   Тело      — Строка — JSON-тело события (UTF-8)
//   Секрет    — Строка — значение константы ИнтелбитРекаСекретWebhook
//   Временная — Число  — unix timestamp (по умолчанию — текущее время UTC+3)
//
// Возвращаемое значение:
//   Строка — значение заголовка X-Signature
Функция СформироватьПодпись(Тело, Секрет, Временная = Неопределено) Экспорт
	Если Временная = Неопределено Тогда
		НачалоEpoch = Дата(1970, 1, 1, 3, 0, 0);
		Временная   = Цел(ТекущаяДата() - НачалоEpoch);
	КонецЕсли;

	СтрВременная      = Формат(Временная, "ЧДЦ=0; ЧН=0; ЧГ=0");
	СообщениеДляПодписи = СтрВременная + "." + Тело;
	ПодписьHex          = ВычислитьHMACSHA256(СообщениеДляПодписи, Секрет);

	Возврат "t=" + СтрВременная + ",v1=" + ПодписьHex;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// ВычислитьHMACSHA256 — HMAC-SHA256 через ХэшированиеДанных платформы 1С.
Функция ВычислитьHMACSHA256(Сообщение, Ключ)
	РазмерБлока = 64;

	КлючДД = СтрокаВДД(Ключ);
	Если КлючДД.Размер() > РазмерБлока Тогда
		Хэш = Новый ХэшированиеДанных(ХэшФункция.SHA256);
		Хэш.Добавить(КлючДД);
		КлючДД = Хэш.РезультатДвоичныеДанные();
	КонецЕсли;

	КлючБайты = ДДВМассивБайт(КлючДД, РазмерБлока);
	КлючIPad  = МассивБайтXOR(КлючБайты, 54);   // 0x36
	КлючOPad  = МассивБайтXOR(КлючБайты, 92);   // 0x5C

	СообщениеДД = СтрокаВДД(Сообщение);

	// SHA256(K⊕ipad ∥ message)
	ВнутрДД = СклеитьДД(МассивБайтВДД(КлючIPad), СообщениеДД);
	ВнутрХэш = Новый ХэшированиеДанных(ХэшФункция.SHA256);
	ВнутрХэш.Добавить(ВнутрДД);
	ВнутрРез = ВнутрХэш.РезультатДвоичныеДанные();

	// SHA256(K⊕opad ∥ inner_hash)
	ВнешнДД = СклеитьДД(МассивБайтВДД(КлючOPad), ВнутрРез);
	ВнешнХэш = Новый ХэшированиеДанных(ХэшФункция.SHA256);
	ВнешнХэш.Добавить(ВнешнДД);

	Возврат НижнийРегистр(ВнешнХэш.РезультатСтрока());
КонецФункции

// СтрокаВДД — конвертирует строку в двоичные данные UTF-8.
Функция СтрокаВДД(Строка)
	Поток  = Новый ПотокВПамяти;
	Запись = Новый ЗаписьТекста(Поток, "UTF-8", , Ложь);
	Запись.Записать(Строка);
	Запись.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

// ДДВМассивБайт — читает до РазмерМассива байт из двоичных данных в массив.
// Остаток заполняется нулями.
Функция ДДВМассивБайт(ДД, РазмерМассива)
	Байты = Новый Массив(РазмерМассива);
	Для и = 0 По РазмерМассива - 1 Цикл
		Байты[и] = 0;
	КонецЦикла;
	Поток  = ДД.ОткрытьПотокДляЧтения();
	Чтение = Новый ЧтениеДанных(Поток);
	Размер = Мин(ДД.Размер(), РазмерМассива);
	Для и = 0 По Размер - 1 Цикл
		Байты[и] = Чтение.ПрочитатьБайт();
	КонецЦикла;
	Чтение.Закрыть();
	Поток.Закрыть();
	Возврат Байты;
КонецФункции

// МассивБайтXOR — XOR каждого байта массива с константой Маска (0-255).
Функция МассивБайтXOR(Байты, Маска)
	Рез = Новый Массив(Байты.Количество());
	Для и = 0 По Байты.Количество() - 1 Цикл
		Рез[и] = БайтXOR(Байты[и], Маска);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// МассивБайтВДД — конвертирует массив байт обратно в двоичные данные.
Функция МассивБайтВДД(Байты)
	Поток  = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Для Каждого Байт Из Байты Цикл
		Запись.ЗаписатьБайт(Байт);
	КонецЦикла;
	Запись.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

// СклеитьДД — конкатенация двух двоичных данных.
Функция СклеитьДД(ДД1, ДД2)
	Поток  = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток);
	Запись.ЗаписатьДвоичныеДанные(ДД1);
	Запись.ЗаписатьДвоичныеДанные(ДД2);
	Запись.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

// БайтXOR — побитовое XOR двух байт (0-255) без встроенных битовых операций BSL.
Функция БайтXOR(А, Б)
	Рез = 0;
	В   = 1;
	Для и = 0 По 7 Цикл
		БитА = Цел(А / В) % 2;
		БитБ = Цел(Б / В) % 2;
		Если БитА <> БитБ Тогда
			Рез = Рез + В;
		КонецЕсли;
		В = В * 2;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// РазобратьURL — разбирает URL на хост, порт, путь, схему.
Функция РазобратьURL(АдресURL)
	Рез = Новый Структура("Хост,Порт,Путь,HTTPS", "", 80, "/", Ложь);

	Если Найти(АдресURL, "https://") = 1 Тогда
		Рез.HTTPS       = Истина;
		Рез.Порт        = 443;
		АдресБезСхемы   = Сред(АдресURL, 9);
	ИначеЕсли Найти(АдресURL, "http://") = 1 Тогда
		АдресБезСхемы = Сред(АдресURL, 8);
	Иначе
		АдресБезСхемы = АдресURL;
	КонецЕсли;

	ПозСлеш = Найти(АдресБезСхемы, "/");
	Если ПозСлеш > 0 Тогда
		ХостПорт  = Лев(АдресБезСхемы, ПозСлеш - 1);
		Рез.Путь  = Сред(АдресБезСхемы, ПозСлеш);
	Иначе
		ХостПорт = АдресБезСхемы;
	КонецЕсли;

	ПозДвоет = Найти(ХостПорт, ":");
	Если ПозДвоет > 0 Тогда
		Рез.Хост = Лев(ХостПорт, ПозДвоет - 1);
		Рез.Порт = Число(Сред(ХостПорт, ПозДвоет + 1));
	Иначе
		Рез.Хост = ХостПорт;
	КонецЕсли;

	Возврат Рез;
КонецФункции

#КонецОбласти
