#Область ПрограммныйИнтерфейс

// ПроверитьАутентификацию — проверяет заголовок Authorization входящего запроса.
//
// Параметры:
//   Запрос — HTTPСервисЗапрос
//
// Возвращаемое значение:
//   Структура — поля: Успех (Булево), ПользовательID (Строка), ОшибкаКод (Строка)
Функция ПроверитьАутентификацию(Запрос) Экспорт
	Результат = Новый Структура("Успех,ПользовательID,ОшибкаКод",
		Ложь, "", "ERR_UNAUTHORIZED");

	ЗначениеAuth = Запрос.Заголовки["Authorization"];

	Если ПустаяСтрока(ЗначениеAuth) Тогда
		Результат.ОшибкаКод = "ERR_NO_AUTH_HEADER";
		Возврат Результат;
	КонецЕсли;

	Если Лев(ЗначениеAuth, 7) = "Bearer " Тогда
		РезBearer = ПроверитьBearer(Сред(ЗначениеAuth, 8));
		Если РезBearer.Действителен Тогда
			Результат.Успех          = Истина;
			Результат.ПользовательID = Строка(РезBearer.Payload["sub"]);
			Результат.ОшибкаКод      = "";
		Иначе
			Результат.ОшибкаКод = "ERR_INVALID_TOKEN";
		КонецЕсли;

	ИначеЕсли Лев(ЗначениеAuth, 6) = "Basic " Тогда
		Попытка
			ДД    = Base64Значение(Сред(ЗначениеAuth, 7));
			Поток = ДД.ОткрытьПотокДляЧтения();
			ЧтениеТекста = Новый ЧтениеТекста(Поток, "UTF-8");
			Декодировано = ЧтениеТекста.Прочитать();
			ЧтениеТекста.Закрыть();
			Поток.Закрыть();

			ПозДвоеточие = Найти(Декодировано, ":");
			Если ПозДвоеточие > 0 Тогда
				Логин  = Лев(Декодировано, ПозДвоеточие - 1);
				Пароль = Сред(Декодировано, ПозДвоеточие + 1);
				Если ПроверитьBasicAuth(Логин, Пароль) Тогда
					Результат.Успех          = Истина;
					Результат.ПользовательID = Логин;
					Результат.ОшибкаКод      = "";
				Иначе
					Результат.ОшибкаКод = "ERR_INVALID_CREDENTIALS";
				КонецЕсли;
			Иначе
				Результат.ОшибкаКод = "ERR_MALFORMED_BASIC";
			КонецЕсли;
		Исключение
			Результат.ОшибкаКод = "ERR_MALFORMED_BASIC";
		КонецПопытки;

	Иначе
		Результат.ОшибкаКод = "ERR_UNSUPPORTED_SCHEME";
	КонецЕсли;

	Возврат Результат;
КонецФункции

// ПроверитьBearer — разбирает JWT payload и проверяет срок действия (exp).
// Подпись в dev-окружении не валидируется — используйте WAF или API-шлюз.
//
// Параметры:
//   Токен — Строка — значение Bearer-токена без префикса "Bearer "
//
// Возвращаемое значение:
//   Структура — поля: Действителен (Булево), Payload (Соответствие), Ошибка (Строка)
Функция ПроверитьBearer(Токен) Экспорт
	Результат = Новый Структура("Действителен,Payload,Ошибка",
		Ложь, Новый Соответствие, "");

	Части = СтрРазделить(Токен, ".", Ложь);
	Если Части.Количество() <> 3 Тогда
		Результат.Ошибка = "Неверный формат JWT: ожидалось 3 секции";
		Возврат Результат;
	КонецЕсли;

	// Декодируем payload (вторая секция, base64url)
	Base64Payload = Части[1];
	Остаток = СтрДлина(Base64Payload) % 4;
	Если Остаток = 2 Тогда
		Base64Payload = Base64Payload + "==";
	ИначеЕсли Остаток = 3 Тогда
		Base64Payload = Base64Payload + "=";
	КонецЕсли;
	Base64Payload = СтрЗаменить(СтрЗаменить(Base64Payload, "-", "+"), "_", "/");

	Попытка
		ДД = Base64Значение(Base64Payload);
		Поток = ДД.ОткрытьПотокДляЧтения();
		ЧтениеТекста = Новый ЧтениеТекста(Поток, "UTF-8");
		JSONСтрока = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		Поток.Закрыть();

		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(JSONСтрока);
		Payload = ПрочитатьJSON(Чтение);

		ЗначениеExp = Payload["exp"];
		Если ЗначениеExp <> Неопределено Тогда
			// Дата(1970,1,1,3,0,0) = epoch в UTC+3 (московское время)
			НачалоEpoch = Дата(1970, 1, 1, 3, 0, 0);
			UnixСейчас  = Цел(ТекущаяДата() - НачалоEpoch);
			Если UnixСейчас > ЗначениеExp Тогда
				Результат.Ошибка = "JWT просрочен";
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;

		Результат.Действителен = Истина;
		Результат.Payload      = Payload;
	Исключение
		Результат.Ошибка = "Ошибка декодирования JWT: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат Результат;
КонецФункции

// ПроверитьBasicAuth — сверяет логин/пароль с константами dev-окружения.
// В prod замените на интеграцию с IdP или LDAP.
//
// Параметры:
//   Логин  — Строка
//   Пароль — Строка
//
// Возвращаемое значение:
//   Булево
Функция ПроверитьBasicAuth(Логин, Пароль) Экспорт
	РазрешённыйЛогин  = Константы.ИнтелбитРекаКлиентID.Получить();
	РазрешённыйПароль = Константы.ИнтелбитРекаСекретWebhook.Получить();
	Возврат Логин = РазрешённыйЛогин И Пароль = РазрешённыйПароль;
КонецФункции

#КонецОбласти
