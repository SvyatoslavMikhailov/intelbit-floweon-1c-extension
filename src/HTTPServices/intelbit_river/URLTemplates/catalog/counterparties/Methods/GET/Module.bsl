// GET /intelbit_river/catalog/counterparties — список контрагентов с пагинацией.
// Параметры запроса: $top, $skip, inn (фильтр по ИНН).
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

Функция ВыполнитьЗапрос(Запрос)
	РезАут = ИнтелбитРекаАутентификация.ПроверитьАутентификацию(Запрос);
	Если НЕ РезАут.Успех Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(401,
			РезАут.ОшибкаКод, "Требуется аутентификация");
	КонецЕсли;

	Параметры = ИнтелбитРекаОбщие.ПолучитьПараметрыURL(Запрос);

	Лимит    = Число(?(ПустаяСтрока(Параметры["$top"]),  "100", Параметры["$top"]));
	Смещение = Число(?(ПустаяСтрока(Параметры["$skip"]), "0",   Параметры["$skip"]));
	ИНН      = Параметры["inn"];

	Если Лимит  <= 0 ИЛИ Лимит  > 1000 Тогда Лимит   = 100; КонецЕсли;
	Если Смещение < 0 Тогда Смещение = 0; КонецЕсли;

	УсловиеИНН = "";
	Если НЕ ПустаяСтрока(ИНН) Тогда
		УсловиеИНН = "И Контр.ИНН = &ИНН";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ &Лимит
		|	Контр.Ссылка.УникальныйИдентификатор() КАК ref_key,
		|	Контр.Наименование                     КАК name,
		|	Контр.ИНН                              КАК inn,
		|	Контр.КПП                              КАК kpp,
		|	Контр.ЮридическийФизическийЛицо        КАК entity_type
		|ИЗ
		|	Справочник.Контрагенты КАК Контр
		|ГДЕ
		|	НЕ Контр.ПометкаУдаления
		|	И НЕ Контр.ЭтоГруппа
		|	" + УсловиеИНН + "
		|УПОРЯДОЧИТЬ ПО
		|	Контр.Наименование";

	Запрос.УстановитьПараметр("Лимит", Лимит + Смещение);
	Если НЕ ПустаяСтрока(ИНН) Тогда
		Запрос.УстановитьПараметр("ИНН", ИНН);
	КонецЕсли;

	РезЗапроса = Запрос.Выполнить();
	Выборка    = РезЗапроса.Выбрать();

	Для и = 1 По Смещение Цикл
		Если НЕ Выборка.Следующий() Тогда Прервать; КонецЕсли;
	КонецЦикла;

	МассивКонтрагентов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивКонтрагентов.Добавить(Новый Структура(
			"ref_key,name,inn,kpp,entity_type",
			Выборка.ref_key,
			Выборка.name,
			Выборка.inn,
			Выборка.kpp,
			Выборка.entity_type
		));
	КонецЦикла;

	Возврат ИнтелбитРекаОбщие.СформироватьУспешныйОтвет(
		Новый Структура("value,count",
			МассивКонтрагентов, МассивКонтрагентов.Количество()));
КонецФункции
