// GET /intelbit_river/catalog/products — список номенклатуры с пагинацией.
// Параметры запроса: $top, $skip, $filter (поиск в наименовании), code (поиск по артикулу).
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

Функция ВыполнитьЗапрос(Запрос)
	РезАут = ИнтелбитРекаАутентификация.ПроверитьАутентификацию(Запрос);
	Если НЕ РезАут.Успех Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(401,
			РезАут.ОшибкаКод, "Требуется аутентификация");
	КонецЕсли;

	Параметры = ИнтелбитРекаОбщие.ПолучитьПараметрыURL(Запрос);

	Лимит    = Число(?(ПустаяСтрока(Параметры["$top"]),  "100", Параметры["$top"]));
	Смещение = Число(?(ПустаяСтрока(Параметры["$skip"]), "0",   Параметры["$skip"]));
	Фильтр   = Параметры["$filter"];
	Артикул  = Параметры["code"];

	Если Лимит  <= 0 ИЛИ Лимит  > 1000 Тогда Лимит   = 100; КонецЕсли;
	Если Смещение < 0 Тогда Смещение = 0; КонецЕсли;

	УсловиеФильтр = "";
	Если НЕ ПустаяСтрока(Фильтр) Тогда
		УсловиеФильтр = "И Ном.Наименование ПОДОБНО &Фильтр";
	КонецЕсли;

	УсловиеАртикул = "";
	Если НЕ ПустаяСтрока(Артикул) Тогда
		УсловиеАртикул = "И Ном.Артикул = &Артикул";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ &Лимит
		|	Ном.Ссылка.УникальныйИдентификатор() КАК ref_key,
		|	Ном.Наименование                     КАК name,
		|	Ном.Артикул                          КАК sku,
		|	Ном.ЕдиницаИзмерения.Наименование    КАК unit,
		|	Ном.ВидНоменклатуры.Наименование     КАК category,
		|	Ном.Описание                         КАК description
		|ИЗ
		|	Справочник.Номенклатура КАК Ном
		|ГДЕ
		|	НЕ Ном.ПометкаУдаления
		|	И НЕ Ном.ЭтоГруппа
		|	" + УсловиеФильтр + "
		|	" + УсловиеАртикул + "
		|УПОРЯДОЧИТЬ ПО
		|	Ном.Наименование";

	Запрос.УстановитьПараметр("Лимит", Лимит + Смещение);
	Если НЕ ПустаяСтрока(Фильтр) Тогда
		Запрос.УстановитьПараметр("Фильтр", "%" + Фильтр + "%");
	КонецЕсли;
	Если НЕ ПустаяСтрока(Артикул) Тогда
		Запрос.УстановитьПараметр("Артикул", Артикул);
	КонецЕсли;

	РезЗапроса = Запрос.Выполнить();
	Выборка    = РезЗапроса.Выбрать();

	Для и = 1 По Смещение Цикл
		Если НЕ Выборка.Следующий() Тогда Прервать; КонецЕсли;
	КонецЦикла;

	МассивТоваров = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивТоваров.Добавить(Новый Структура(
			"ref_key,name,sku,unit,category,description",
			Выборка.ref_key,
			Выборка.name,
			Выборка.sku,
			Выборка.unit,
			Выборка.category,
			Выборка.description
		));
	КонецЦикла;

	Возврат ИнтелбитРекаОбщие.СформироватьУспешныйОтвет(
		Новый Структура("value,count", МассивТоваров, МассивТоваров.Количество()));
КонецФункции
