// GET /intelbit_river/catalog/stocks — остатки номенклатуры по складам.
// Параметры запроса: warehouse_key (GUID склада), nomenclature_key (GUID номенклатуры),
//                   $top, $skip.
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

Функция ВыполнитьЗапрос(Запрос)
	РезАут = ИнтелбитРекаАутентификация.ПроверитьАутентификацию(Запрос);
	Если НЕ РезАут.Успех Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(401,
			РезАут.ОшибкаКод, "Требуется аутентификация");
	КонецЕсли;

	Параметры      = ИнтелбитРекаОбщие.ПолучитьПараметрыURL(Запрос);
	КлючСклада     = Параметры["warehouse_key"];
	КлючНоменклатуры = Параметры["nomenclature_key"];

	Лимит    = Число(?(ПустаяСтрока(Параметры["$top"]),  "200", Параметры["$top"]));
	Смещение = Число(?(ПустаяСтрока(Параметры["$skip"]), "0",   Параметры["$skip"]));

	Если Лимит  <= 0 ИЛИ Лимит  > 2000 Тогда Лимит   = 200; КонецЕсли;
	Если Смещение < 0 Тогда Смещение = 0; КонецЕсли;

	СкладДляФильтра     = Неопределено;
	НоменклатураДляФильтра = Неопределено;

	Если НЕ ПустаяСтрока(КлючСклада) Тогда
		Попытка
			СкладДляФильтра = Справочники.Склады.ПолучитьСсылку(
				Новый УникальныйИдентификатор(КлючСклада));
		Исключение
			Возврат ИнтелбитРекаОбщие.СформироватьОшибку(400,
				"ERR_VALIDATION", "Неверный формат warehouse_key");
		КонецПопытки;
	КонецЕсли;

	Если НЕ ПустаяСтрока(КлючНоменклатуры) Тогда
		Попытка
			НоменклатураДляФильтра = Справочники.Номенклатура.ПолучитьСсылку(
				Новый УникальныйИдентификатор(КлючНоменклатуры));
		Исключение
			Возврат ИнтелбитРекаОбщие.СформироватьОшибку(400,
				"ERR_VALIDATION", "Неверный формат nomenclature_key");
		КонецПопытки;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ &Лимит
		|	Ост.Номенклатура.Ссылка.УникальныйИдентификатор() КАК nomenclature_ref_key,
		|	Ост.Номенклатура.Наименование                     КАК nomenclature_name,
		|	Ост.Номенклатура.Артикул                          КАК sku,
		|	Ост.Склад.Ссылка.УникальныйИдентификатор()        КАК warehouse_ref_key,
		|	Ост.Склад.Наименование                            КАК warehouse_name,
		|	Ост.КоличествоОстаток                             КАК quantity
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(
		|		,
		|		Склад = &Склад И Номенклатура = &Номенклатура
		|	) КАК Ост
		|ГДЕ
		|	Ост.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	Ост.Номенклатура.Наименование";

	Запрос.УстановитьПараметр("Лимит",       Лимит + Смещение);
	Запрос.УстановитьПараметр("Склад",       СкладДляФильтра);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураДляФильтра);

	РезЗапроса = Запрос.Выполнить();
	Выборка    = РезЗапроса.Выбрать();

	Для и = 1 По Смещение Цикл
		Если НЕ Выборка.Следующий() Тогда Прервать; КонецЕсли;
	КонецЦикла;

	МассивОстатков = Новый Массив;
	Пока Выборка.Следующий() Цикл
		МассивОстатков.Добавить(Новый Структура(
			"nomenclature_ref_key,nomenclature_name,sku,warehouse_ref_key,warehouse_name,quantity",
			Выборка.nomenclature_ref_key,
			Выборка.nomenclature_name,
			Выборка.sku,
			Выборка.warehouse_ref_key,
			Выборка.warehouse_name,
			Выборка.quantity
		));
	КонецЦикла;

	Возврат ИнтелбитРекаОбщие.СформироватьУспешныйОтвет(
		Новый Структура("value,count",
			МассивОстатков, МассивОстатков.Количество()));
КонецФункции
