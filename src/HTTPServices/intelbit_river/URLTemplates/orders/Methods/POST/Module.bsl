// POST /intelbit_river/orders/ — создание заказа клиента из веб-витрины.
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

Функция ВыполнитьЗапрос(Запрос)
	РезАут = ИнтелбитРекаАутентификация.ПроверитьАутентификацию(Запрос);
	Если НЕ РезАут.Успех Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(401,
			РезАут.ОшибкаКод, "Требуется аутентификация");
	КонецЕсли;

	ТелоJSON = ИнтелбитРекаОбщие.ПрочитатьТелоJSON(Запрос);
	Если ТелоJSON = Неопределено Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(400,
			"ERR_VALIDATION", "Некорректный JSON в теле запроса");
	КонецЕсли;

	НомерЗаказа = ТелоJSON["order_number"];
	Если НомерЗаказа = Неопределено ИЛИ ПустаяСтрока(НомерЗаказа) Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(400,
			"ERR_VALIDATION", "Поле order_number обязательно");
	КонецЕсли;

	Попытка
		НачатьТранзакцию();

		Заказ = Документы.ЗаказПокупателя.СоздатьДокумент();
		Заказ.Дата = ТекущаяДатаСеанса();
		Заказ.Комментарий = "Витрина: " + НомерЗаказа
			+ ?(ТелоJSON["order_ref_key"] <> Неопределено,
				" [ref=" + ТелоJSON["order_ref_key"] + "]", "");

		КлючКонтрагента = ТелоJSON["counterparty_ref_key"];
		Если КлючКонтрагента <> Неопределено И НЕ ПустаяСтрока(КлючКонтрагента) Тогда
			Попытка
				Заказ.Контрагент = Справочники.Контрагенты.ПолучитьСсылку(
					Новый УникальныйИдентификатор(КлючКонтрагента));
			Исключение
				// Неизвестный контрагент — создаём без контрагента
			КонецПопытки;
		КонецЕсли;

		Заказ.Записать(РежимЗаписиДокумента.Запись);
		ЗафиксироватьТранзакцию();

		RefKey = Строка(Заказ.Ссылка.УникальныйИдентификатор());

		ИнтелбитРекаВебхуки.ОпубликоватьСобытие("order.status.changed",
			Новый Структура("order_ref_key,order_number,old_status,new_status",
				RefKey, НомерЗаказа, "", "НеСогласован"));

		ИнтелбитРекаОбщие.Логировать("Информация",
			"Создан заказ покупателя " + Заказ.Ссылка + " (витрина: " + НомерЗаказа + ")");

		ОтветДанные = Новый Структура(
			"ref_key,order_number,status,created_at",
			RefKey,
			НомерЗаказа,
			"НеСогласован",
			Формат(Заказ.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z"
		);
		Возврат ИнтелбитРекаОбщие.СформироватьУспешныйОтвет(ОтветДанные);

	Исключение
		ОтменитьТранзакцию();
		ИнтелбитРекаОбщие.Логировать("Ошибка",
			"Ошибка создания заказа: " + ОписаниеОшибки());
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(500,
			"ERR_INTERNAL", "Ошибка при создании заказа");
	КонецПопытки;
КонецФункции
