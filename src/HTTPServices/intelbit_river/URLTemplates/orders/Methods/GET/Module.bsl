// GET /intelbit_river/orders/ — список заказов покупателей с фильтрацией.
// Параметры запроса: ref_key (GUID), status, $top, $skip.
// Расширение конфигурации. Apache License 2.0. Подробности — в NOTICE.

Функция ВыполнитьЗапрос(Запрос)
	РезАут = ИнтелбитРекаАутентификация.ПроверитьАутентификацию(Запрос);
	Если НЕ РезАут.Успех Тогда
		Возврат ИнтелбитРекаОбщие.СформироватьОшибку(401,
			РезАут.ОшибкаКод, "Требуется аутентификация");
	КонецЕсли;

	Параметры = ИнтелбитРекаОбщие.ПолучитьПараметрыURL(Запрос);

	Лимит   = Число(?(ПустаяСтрока(Параметры["$top"]),  "50",  Параметры["$top"]));
	Смещение = Число(?(ПустаяСтрока(Параметры["$skip"]), "0",   Параметры["$skip"]));
	RefKey  = Параметры["ref_key"];
	Статус  = Параметры["status"];

	Если Лимит  <= 0 Или Лимит  > 500 Тогда Лимит   = 50; КонецЕсли;
	Если Смещение < 0 Тогда Смещение = 0; КонецЕсли;

	Запрос = Новый Запрос;

	УсловиеGUID = "";
	Если НЕ ПустаяСтрока(RefKey) Тогда
		УсловиеGUID = "И ВЫРАЗИТЬ(Заказ.Ссылка КАК СТРОКА) = &RefKey";
	КонецЕсли;

	УсловиеСтатус = "";
	Если НЕ ПустаяСтрока(Статус) Тогда
		УсловиеСтатус = "И Заказ.СтатусЗаказа = &СтатусФильтр";
	КонецЕсли;

	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ &Лимит
		|	Заказ.Ссылка         КАК Ссылка,
		|	Заказ.Дата           КАК Дата,
		|	Заказ.Номер          КАК Номер,
		|	Заказ.Комментарий    КАК Комментарий,
		|	Заказ.Контрагент.Наименование КАК Контрагент
		|ИЗ
		|	Документ.ЗаказПокупателя КАК Заказ
		|ГДЕ
		|	НЕ Заказ.ПометкаУдаления
		|	" + УсловиеGUID + "
		|	" + УсловиеСтатус + "
		|УПОРЯДОЧИТЬ ПО
		|	Заказ.Дата УБЫВ";

	Запрос.УстановитьПараметр("Лимит", Лимит + Смещение);
	Если НЕ ПустаяСтрока(RefKey) Тогда
		Запрос.УстановитьПараметр("RefKey", RefKey);
	КонецЕсли;
	Если НЕ ПустаяСтрока(Статус) Тогда
		Запрос.УстановитьПараметр("СтатусФильтр", Статус);
	КонецЕсли;

	РезЗапроса = Запрос.Выполнить();
	Выборка    = РезЗапроса.Выбрать();

	// Пропускаем Смещение записей
	Для и = 1 По Смещение Цикл
		Если НЕ Выборка.Следующий() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	МассивЗаказов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		RefKeyЗапись = Строка(Выборка.Ссылка.УникальныйИдентификатор());
		ЗапПоряд = Новый Структура(
			"ref_key,order_number,counterparty,created_at,comment",
			RefKeyЗапись,
			Выборка.Номер,
			Выборка.Контрагент,
			Формат(Выборка.Дата, "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z",
			Выборка.Комментарий
		);
		МассивЗаказов.Добавить(ЗапПоряд);
	КонецЦикла;

	Возврат ИнтелбитРекаОбщие.СформироватьУспешныйОтвет(
		Новый Структура("value,count", МассивЗаказов, МассивЗаказов.Количество()));
КонецФункции
